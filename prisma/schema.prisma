/// Clés-valeurs de configuration de la plateforme JANGANDOO FPT
model PlatformConfig {
  cle         String  @id // ex: MAINTENANCE_MODE, CURRENT_ACADEMIC_YEAR, PLATFORM_SLOGAN, SEUIL_VALIDATION_PAIRS
  valeur      String  @db.Text
  categorie   String? @default("GENERAL") // GENERAL, SECURITE, NOTIFICATIONS, APC
  description String? @db.Text
  estSecurise Boolean @default(false) @map("est_securise")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}
