// 6. MODÉRATION, SIGNALEMENTS & ASSURANCE QUALITÉ
// =============================================================================

/// Signalement d'une anomalie pédagogique ou de sécurité d'atelier
model SignalementPratique {
  id         String   @id @default(uuid())
  practiceId String   @map("practice_id")
  practice   Practice @relation("PracticeSignalements", fields: [practiceId], references: [id], onDelete: Cascade)

  signaleurId String? @map("signaleur_id")
  signaleur   User?   @relation("SignaleurSignalements", fields: [signaleurId], references: [id], onDelete: SetNull)

  signaleurNom   String? @map("signaleur_nom")
  signaleurEmail String? @map("signaleur_email")

  motif       MotifSignalement
  description String            @db.Text
  estUrgent   Boolean           @default(false) @map("est_urgent")
  statut      StatutSignalement @default(NOUVEAU)

  moderateurId String? @map("moderateur_id")
  moderateur   User?   @relation("ModerateurSignalements", fields: [moderateurId], references: [id], onDelete: SetNull)

  resolutionCommentaire String?   @map("resolution_commentaire") @db.Text
  dateResolution        DateTime? @map("date_resolution")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([practiceId])
  @@index([statut])
  @@index([motif])
  @@map("signalements_pratiques")
}

/// Journal d'audit institutionnel et traçabilité des opérations sensibles
model AuditLog {
  id            String  @id @default(uuid())
  utilisateurId String? @map("utilisateur_id")
  utilisateur   User?   @relation("UserAuditLogs", fields: [utilisateurId], references: [id], onDelete: SetNull)

  utilisateurNom  String? @map("utilisateur_nom")
  utilisateurRole String? @map("utilisateur_role")

  action      String // ex: USER_REGISTER, PRACTICE_PUBLISH, PRACTICE_DELETE, ROLE_ASSIGN
  ressource   String // ex: users, practices, referentiels, system
  ressourceId String?     @map("ressource_id")
  details     String?     @db.Text
  statut      StatutAudit @default(SUCCES)

  adresseIp String? @map("adresse_ip")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([utilisateurId])
  @@index([action])
  @@index([ressource])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// 7. ASSISTANCE PÉDAGOGIQUE INTELLIGENTE (IA & APC)
// =============================================================================

/// Modèle de prompt prédéfini pour l'assistance pédagogique intelligente APC
model AIPromptTemplate {
  id             String            @id @default(uuid())
  code           String            @unique // SITUATION_APC, OBJECTIFS_PEDAGOGIQUES, CRITERES_EVALUATION, SECURITE_EPI, REFORMULATION...
  titre          String
  description    String            @db.Text
  categorie      CategoriePromptAI
  templatePrompt String            @map("template_prompt") @db.Text
  systemPrompt   String?           @map("system_prompt") @db.Text
  variables      Json? // ex: ["filiere", "metier", "competence", "titre"]
  estActif       Boolean           @default(true) @map("est_actif")
  ordre          Int               @default(0)

  // Relations
  generations AIGenerationLog[] @relation("PromptTemplateGenerations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categorie])
  @@map("ai_prompt_templates")
}

/// Journal des requêtes et réponses générées par l'assistant pédagogique IA
model AIGenerationLog {
  id String @id @default(uuid())

  utilisateurId String? @map("utilisateur_id")
  utilisateur   User?   @relation("UserAIGenerations", fields: [utilisateurId], references: [id], onDelete: SetNull)

  promptTemplateId String?           @map("prompt_template_id")
  promptTemplate   AIPromptTemplate? @relation("PromptTemplateGenerations", fields: [promptTemplateId], references: [id], onDelete: SetNull)

  mode             CategoriePromptAI
  contextePrompt   String            @map("contexte_prompt") @db.Text
  contenuGenere    String            @map("contenu_genere") @db.Text
  modeleUtilise    String?           @map("modele_utilise") // gemini-2.5-flash, etc.
  jetonsUtilises   Int?              @map("jetons_utilises")
  scoreQualite     Int?              @map("score_qualite") // Feedback 1 à 5
  injecteDansFiche Boolean           @default(false) @map("injecte_dans_fiche")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([utilisateurId])
  @@index([promptTemplateId])
  @@index([mode])
  @@map("ai_generation_logs")
}

