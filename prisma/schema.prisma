/// Gabarits des courriels transactionnels et institutionnels
model EmailTemplate {
  id         String  @id @default(uuid())
  code       String  @unique // CONFIRMATION_INSCRIPTION, VALIDATION_COMPTE, NOUVEAU_RETOUR_DIDACTIQUE...
  nom        String
  sujet      String
  corpsHtml  String  @map("corps_html") @db.Text
  corpsTexte String? @map("corps_texte") @db.Text
  variables  Json? // ex: ["nom", "prenom", "etablissement", "lien_validation"]
  estActif   Boolean @default(true) @map("est_actif")

  // Relations
  emailLogs EmailLog[] @relation("TemplateEmailLogs")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

/// Journal d'audit d'expédition des courriels (SMTP / Gmail)
model EmailLog {
  id String @id @default(uuid())

  destinataireEmail String  @map("destinataire_email")
  destinataireId    String? @map("destinataire_id")
  destinataire      User?   @relation("UserEmailLogs", fields: [destinataireId], references: [id], onDelete: SetNull)

  templateId String?        @map("template_id")
  template   EmailTemplate? @relation("TemplateEmailLogs", fields: [templateId], references: [id], onDelete: SetNull)

  sujet         String
  statut        StatutEnvoiEmail @default(ENVOYE)
  messageIdSmtp String?          @map("message_id_smtp")
  erreurMessage String?          @map("erreur_message") @db.Text
  tentatives    Int              @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([destinataireEmail])
  @@index([destinataireId])
  @@index([statut])
  @@index([createdAt])
  @@map("email_logs")
}

