/// Tutoriels rapides et guides didactiques interactifs
model TutorielRapide {
  id              String            @id @default(uuid())
  code            String            @unique // RECIT_APC, ATELIER_SECURITE, EVALUATION_PAIRS...
  titre           String
  description     String            @db.Text
  categorie       CategorieTutoriel @default(PREMIERS_PAS)
  dureeEstimeeMin Int               @default(5) @map("duree_estimee_min")
  badgeNiveau     String?           @map("badge_niveau") // Débutant, Intermédiaire, Avancé
  icone           String?
  lienCible       String?           @map("lien_cible")
  etapes          Json // Liste ordonnée des étapes
  estPublie       Boolean           @default(true) @map("est_publie")
  ordre           Int               @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

